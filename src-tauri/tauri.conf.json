{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netzwerk-Speedtest",
  "version": "1.0.2",
  "identifier": "de.infralatis.netzwerkspeedtest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Netzwerk-Speedtest",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#0B0F17",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "infralatis",
    "copyright": "© infralatis",
    "category": "Utility",
    "shortDescription": "Netzwerk-Speedtest für LAN und Internet",
    "longDescription": "Misst Geschwindigkeit im lokalen Netz (gegen eine Gegenstelle) und ins Internet, per Kabel oder WLAN, mit Ampelbewertung und PDF-Bericht.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ]
      }
    }
  },
  "mainBinaryName": "Netzwerk-Speedtest",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFODBEN0Y4MEZEOURDQkIKUldTNzNOa1ArTmVBVHZEWlJqUUFSVnUxc0FEMnJ3OC9GdmRhcFJsYjZrc1hJUU9TbStaVW15YjQK",
      "endpoints": [
        "https://github.com/klopsnic-cyber/netzwerk-speedtest/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}